# Template for the .env file that sits next to docker-compose.prod.yml ON THE
# SERVER. Copy it there, fill in real values, and keep it out of git:
#
#   scp .env.production.example user@server:/opt/talabaty/.env
#
# Lock it down once it holds real secrets:
#   chmod 600 /opt/talabaty/.env

# --- Database ---------------------------------------------------------------
# Not the values from the old committed application.properties. Pick a fresh
# password; the database is not exposed outside the compose network, but a
# reused credential is still a reused credential.
DB_USERNAME=talabaty
DB_PASSWORD=

# --- JWT --------------------------------------------------------------------
# REQUIRED. Base64 decoding to at least 32 bytes. Generate a NEW one:
#   openssl rand -base64 32
# Do not reuse the key that was committed to this repository - it is public.
JWT_SECRET=

# --- CORS -------------------------------------------------------------------
# REQUIRED, and load-bearing here: the frontend is not deployed to this server,
# so every browser call to this API is cross-origin. List the exact origin the
# Angular app is served from - scheme + host + port, no trailing slash and no
# path. A mismatch means the browser blocks every request, and the failure
# looks like a network error rather than a CORS message.
# Comma-separated for more than one:
#   http://localhost:4200,http://193.181.217.106:4200
CORS_ALLOWED_ORIGINS=http://localhost:4200

# --- API port ---------------------------------------------------------------
# Host port the API is published on. 8080 is currently CLOSED in this server's
# firewall, so open it (sudo ufw allow 8080/tcp) or pick a port already open.
# Port 80 is not free - something is already serving there.
API_PORT=8080

# --- Image tag --------------------------------------------------------------
# 'latest' follows main. Pin a full commit SHA to freeze a known-good build, and
# roll back by changing this and re-running `docker compose up -d`:
#   IMAGE_TAG=sha-4f2757a1b2c3...
IMAGE_TAG=latest

# --- OTP e-mail -------------------------------------------------------------
# Leave OTP_ENABLED=false until real SMTP credentials exist. The Gmail app
# password that used to be committed here must be revoked, not reused:
#   https://myaccount.google.com/apppasswords
MAIL_USERNAME=
MAIL_PASSWORD=
OTP_ENABLED=false
