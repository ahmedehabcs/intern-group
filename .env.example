# Copy to .env and fill in. .env is git-ignored; never commit real values.
#   cp .env.example .env
#
# Every variable here has a working local default in application.properties,
# except the ones marked REQUIRED IN PRODUCTION.

# --- Database ---------------------------------------------------------------
DB_USERNAME=postgres
DB_PASSWORD=postgres

# The host port Postgres is reachable on. One knob, two jobs: it is the port
# the container publishes (docker-compose.yml) AND the port the local default
# in application.properties connects to, because that URL is built from it.
#
# Keep 5432 if you have no natively installed PostgreSQL. If you do, the
# container cannot bind 5432 - "port is already allocated" - so either stop
# that service or move the container aside with:
#   DB_PORT=5433
#
# Set this and nothing else. It used to be necessary to edit DB_URL to match,
# and forgetting made anything outside Docker connect to whatever else owned
# 5432 - usually a different PostgreSQL, failing with a misleading
# "password authentication failed for user postgres".
DB_PORT=5432

# Only needed to point at a database that is not localhost:${DB_PORT} - a
# managed instance in production, say. Setting it overrides DB_PORT entirely,
# so leave it unset locally. The backend container does set it, to reach
# postgres:5432 across the compose network.
#DB_URL=jdbc:postgresql://localhost:5432/talabaty_db

# --- JWT --------------------------------------------------------------------
# REQUIRED IN PRODUCTION. Base64 that decodes to >= 32 bytes. Generate with:
#   openssl rand -base64 32
# The default baked into application.properties is public and dev-only.
JWT_SECRET=
JWT_EXPIRATION_SECONDS=900

# --- CORS -------------------------------------------------------------------
# REQUIRED IN PRODUCTION. Comma-separated browser origins allowed to call the
# API. Must include the deployed frontend origin or every request is blocked.
CORS_ALLOWED_ORIGINS=http://localhost:4200

# --- Login rate limiting ----------------------------------------------------
LOGIN_MAX_FAILED_ATTEMPTS=5
LOGIN_RATE_LIMIT_WINDOW_SECONDS=900

# --- OTP e-mail -------------------------------------------------------------
# Leave MAIL_USERNAME/MAIL_PASSWORD empty and set OTP_ENABLED=false to run
# without SMTP. For Gmail, MAIL_PASSWORD is an app password, not the account
# password: https://myaccount.google.com/apppasswords
MAIL_HOST=smtp.gmail.com
MAIL_PORT=587
MAIL_USERNAME=
MAIL_PASSWORD=
OTP_ENABLED=true
