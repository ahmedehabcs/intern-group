# Copy to .env and fill in. .env is git-ignored; never commit real values.
#   cp .env.example .env
#
# Every variable here has a working local default in application.properties,
# except the ones marked REQUIRED IN PRODUCTION.

# --- Database ---------------------------------------------------------------
DB_URL=jdbc:postgresql://localhost:5432/talabaty_db
DB_USERNAME=postgres
DB_PASSWORD=postgres

# Host port the Postgres container publishes on (docker-compose.yml only).
# Keep 5432 if you have no natively installed PostgreSQL. If you do, either
# stop that service or move the container aside and point DB_URL at it too:
#   DB_PORT=5433
#   DB_URL=jdbc:postgresql://localhost:5433/talabaty_db
DB_PORT=5432

# --- JWT --------------------------------------------------------------------
# REQUIRED IN PRODUCTION. Base64 that decodes to >= 32 bytes. Generate with:
#   openssl rand -base64 32
# The default baked into application.properties is public and dev-only.
JWT_SECRET=
JWT_EXPIRATION_SECONDS=900

# --- CORS -------------------------------------------------------------------
# REQUIRED IN PRODUCTION. Comma-separated browser origins allowed to call the
# API. Must include the deployed frontend origin or every request is blocked.
CORS_ALLOWED_ORIGINS=http://localhost:4200

# --- Login rate limiting ----------------------------------------------------
LOGIN_MAX_FAILED_ATTEMPTS=5
LOGIN_RATE_LIMIT_WINDOW_SECONDS=900

# --- OTP e-mail -------------------------------------------------------------
# Leave MAIL_USERNAME/MAIL_PASSWORD empty and set OTP_ENABLED=false to run
# without SMTP. For Gmail, MAIL_PASSWORD is an app password, not the account
# password: https://myaccount.google.com/apppasswords
MAIL_HOST=smtp.gmail.com
MAIL_PORT=587
MAIL_USERNAME=
MAIL_PASSWORD=
OTP_ENABLED=true
